{
  "name": "codev-ai",
  "version": "0.2.5",
  "description": "CoDev — AI Coding Agent Hub. Install, configure, and manage multiple AI coding agents.",
  "keywords": [
    "ai",
    "cli",
    "coding-agent"
  ],
  "type": "module",
  "bin": {
    "codev": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsx build.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "fix": "biome check --write",
    "prepare": "husky",
    "prepublishOnly": "pnpm check && pnpm typecheck && pnpm test && pnpm build && node dist/index.js --version",
    "prepack": "mv README.md .readme-repo.bak && mv README.npm.md README.md",
    "postpack": "mv README.md README.npm.md && mv .readme-repo.bak README.md"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "pnpm fix",
      "pnpm typecheck"
    ]
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "ink": "^7.0.1",
    "ink-spinner": "^5.0.0",
    "open": "^11.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/iarna__toml": "^2.0.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "esbuild": "^0.25.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^16.4.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
